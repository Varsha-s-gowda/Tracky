# Server
NODE_ENV=development
PORT=5000

# MongoDB (local or MongoDB Atlas SRV connection string)
MONGO_URI=mongodb://127.0.0.1:27017/tracky_ai

# Authentication
# Use a long, random value in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
RESET_TOKEN_TTL_MINUTES=60

# Client (comma-separated list of allowed origins)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Rate limiting (in-memory, per process)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=50
AI_RATE_LIMIT_MAX=30

# AI provider — server only, never expose these to the frontend
# Leave both keys empty to run in rules-only mode.
# AI_PROVIDER is optional; when empty it is inferred from whichever key is set.
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides (defaults: gemini-2.0-flash / gpt-4o-mini)
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_MESSAGES=20
